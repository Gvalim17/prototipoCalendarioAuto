# URL de conexão com o banco de dados
# Desenvolvimento local (SQLite):
DATABASE_URL=sqlite:///./sql_app.db
# Produção (Render) — configure via painel do Render em Environment > Environment Variables:
# DATABASE_URL=postgresql://user:password@host/dbname

# Origens permitidas para CORS (separadas por vírgula, sem espaços)
# Desenvolvimento local:
ALLOWED_ORIGINS=http://localhost:5173
# Produção (Render) — configure via painel do Render em Environment > Environment Variables:
# ALLOWED_ORIGINS=https://calendarioauto.vercel.app
# Para múltiplos domínios: ALLOWED_ORIGINS=https://calendarioauto.vercel.app,http://localhost:5173

# Em produção, prefira rodar migrações Alembic e desabilitar create_all automático:
# AUTO_CREATE_TABLES=false

# Token opcional para endpoints destrutivos em massa, enviado no header X-Admin-Action-Token.
# Se vazio ou ausente, mantém o comportamento local sem bloqueio.
# ADMIN_ACTION_TOKEN=troque-por-um-token-forte

# Autenticação: recomendado em produção — apenas este e-mail vira administrador
# ao se cadastrar (por senha ou Google). Sem esta variável, o sistema volta ao
# comportamento implícito de "primeira conta criada = admin" (fica registrado
# em /logs quando isso acontece).
# BOOTSTRAP_ADMIN_EMAIL=voce@sua-instituicao.edu.br

# Em produção, deixe o cadastro aberto apenas até criar as contas necessárias;
# depois use ALLOW_SELF_REGISTRATION=false. Novas contas depois disso são
# criadas por um administrador em Configurações > Usuários (convite por e-mail).
ALLOW_SELF_REGISTRATION=true
SESSION_DAYS=30
# Local HTTP: false. Produção HTTPS: true.
COOKIE_SECURE=false
# Use "none" somente quando frontend e API estiverem em sites diferentes, sempre com COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# LGPD e logs: use uma chave longa, aleatória e exclusiva por ambiente para
# pseudonimizar IPs. Não use uma senha reutilizada.
LOG_PII_SALT=gere-um-segredo-longo-e-aleatorio
# Retenção e descarte devem ser definidos pela política de privacidade da instituição.
# Os arquivos de log são rotacionados por tamanho; não registre dados pessoais em mensagens.
PRIVACY_POLICY_VERSION=2026-07

# Login Google (OAuth 2.0). Cadastre a URL abaixo como Redirect URI no Google Cloud.
# Nunca envie GOOGLE_OAUTH_CLIENT_SECRET ao frontend nem versiona este arquivo com valores reais.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# URL pública do frontend para onde o backend retorna após o Google.
FRONTEND_URL=http://localhost:5173
# Opcional: restringe o acesso a uma organização Google Workspace.
# GOOGLE_WORKSPACE_DOMAIN=sua-instituicao.edu.br

# Recuperação de senha por e-mail. Use uma conta SMTP própria do sistema;
# em provedores com MFA, use uma senha de aplicativo, nunca sua senha pessoal.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Calendário Acadêmico <no-reply@seu-dominio.com>
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Executor de alertas: SEM ISSO OS ALERTAS NÃO SÃO ENVIADOS. O Render (plano
# free) não tem cron nativo, então é preciso um agendador externo gratuito
# chamando o endpoint abaixo a cada 5 minutos. Passo a passo com cron-job.org:
#   1. Gere um token forte para ALERT_DISPATCH_TOKEN abaixo e salve no Render
#      (Environment > Environment Variables), redeploy o serviço.
#   2. Crie uma conta grátis em https://cron-job.org
#   3. "Create cronjob" > URL: https://SEU-BACKEND.onrender.com/system/alerts/dispatch
#   4. Método: POST · Intervalo: a cada 5 minutos
#   5. Em "Advanced > Headers", adicione:
#        X-Alert-Dispatch-Token: <o mesmo valor de ALERT_DISPATCH_TOKEN>
#   6. Salve e ative. O endpoint é idempotente — reexecuções não duplicam alertas.
ALERT_DISPATCH_TOKEN=gere-um-segredo-longo-e-aleatorio
# Alternativa: agendar `python -m app.alert_worker` a cada 5 minutos num
# worker/cron nativo do seu provedor (não expõe token pela rede).
